#!/bin/bash
set -euo pipefail

# --- Resolve private-network NIC + IP via the routing table ---
# `ip route show to <cidr>` prints the route whose destination is the
# private subnet; the `dev <iface>` token names the interface, and
# `ip -4 -o addr show <iface>` gives us its IPv4. Robust across NIC
# renames between Hetzner image revisions.
PRIV_IFACE="$(ip -4 -o route show to ${private_cidr} | awk '{print $3}' | head -n1)"
if [ -z "$PRIV_IFACE" ]; then
  echo "FATAL: could not resolve private NIC for ${private_cidr}" >&2
  exit 1
fi
PRIV_IP="$(ip -4 -o addr show "$PRIV_IFACE" | awk '{print $4}' | cut -d/ -f1)"

# --- Resolve public IPv4 from Hetzner instance metadata ---
# Link-local, available before any egress is configured; reliable from
# cloud-init. The value is passed to `--tls-san` so the API-server
# cert covers the public IP — required because the kubeconfig used by
# CI under `use_hetzner=true` and the operator override at
# https://<cp-public-ip>:6443 both rely on the public IP being in the
# cert SAN list. Without this, every kubectl call from those paths
# would fail TLS verification.
PUBLIC_IP="$(curl -fsSL -m 10 \
  http://169.254.169.254/hetzner/v1/metadata/public-ipv4)"
if [ -z "$PUBLIC_IP" ]; then
  echo "FATAL: could not resolve public IPv4 from Hetzner metadata" >&2
  exit 1
fi

%{ if install_gvisor ~}
# --- Stage the containerd config template BEFORE k3s starts ---
# k3s ships its own containerd config at
# /var/lib/rancher/k3s/agent/etc/containerd/config.toml, rendered from
# config.toml.tmpl. Write the override file FIRST so the initial k3s
# start picks it up cleanly (avoids a half-written file race that would
# otherwise need `systemctl stop/start`).
mkdir -p /var/lib/rancher/k3s/agent/etc/containerd
cat <<'TMPL' >/var/lib/rancher/k3s/agent/etc/containerd/config.toml.tmpl
{{ template "base" . }}

[plugins."io.containerd.grpc.v1.cri".containerd.runtimes.runsc]
  runtime_type = "io.containerd.runsc.v1"
TMPL

# --- Install gVisor (runsc) binary, referenced by the template above ---
# Pinned to release/20240115 — `release/latest` could ship a
# binary-contract change mid-rebuild and silently destabilize the
# cluster. The SHA-256 is verified post-download; if the upstream
# object changes underneath us, the install fails fast.
# Rotation: bump GVISOR_RELEASE + GVISOR_SHA256_X86_64/AARCH64 here
# AND in the agent template, then re-apply the module.
# Note: the gVisor release tree uses `release/<YYYYMMDD>/<uname-arch>/runsc`
# (e.g. `release/20240115/x86_64/runsc`) — NOT amd64/arm64 — and the
# release ID has no `.0` suffix. SHA-256s captured by downloading the
# pinned binary and `shasum -a 256` on a developer workstation.
GVISOR_RELEASE="release/20240115"
GVISOR_SHA256_X86_64="9ae176da972b288880e69b1a438052eea2c502b6292aea8a1a33fbcf65e135dd"
GVISOR_SHA256_AARCH64="7b2ce18408212542477c31cc1bd0ddddf6fbf7439d57e56f6884091f62c81cd8"

ARCH="$(uname -m)"
case "$ARCH" in
  x86_64)  GVISOR_SHA256="$${GVISOR_SHA256_X86_64}" ;;
  aarch64) GVISOR_SHA256="$${GVISOR_SHA256_AARCH64}" ;;
  *) echo "unsupported arch $ARCH"; exit 1 ;;
esac
URL="https://storage.googleapis.com/gvisor/releases/$${GVISOR_RELEASE}/$${ARCH}"
curl -fsSL "$${URL}/runsc" -o /usr/local/bin/runsc
echo "$${GVISOR_SHA256}  /usr/local/bin/runsc" | sha256sum -c -
chmod +x /usr/local/bin/runsc
%{ endif ~}

# --- Install k3s server ---
# --disable=servicelb,traefik because we use Cloudflare Tunnel for
# ingress and don't need LB-backed services. Pin the version channel
# via INSTALL_K3S_CHANNEL.
#
# The CP is labeled gvisor=false: system workloads (ESO, cert-manager,
# Cloudflare Tunnel, CCM, CSI) run on runc on the CP; the runsc
# RuntimeClass nodeSelector matches gvisor=true workers only.
export INSTALL_K3S_CHANNEL="${k3s_version}"
export K3S_TOKEN="${k3s_token}"

curl -sfL https://get.k3s.io | sh -s - server \
  --cluster-init \
  --disable=servicelb \
  --disable=traefik \
  --flannel-iface="$PRIV_IFACE" \
  --node-ip="$PRIV_IP" \
  --tls-san="$PUBLIC_IP" \
  --node-label=sternaway.ai/gvisor=false \
  --kubelet-arg=cloud-provider=external \
  --kube-controller-manager-arg=cloud-provider=external \
  --kube-apiserver-arg=cloud-provider=external

# Wait for kubeconfig to be readable, then for the API to respond.
# Nodes will be NotReady until CCM applies (task 27) — that is OK;
# the API server is up and `terraform output` can proceed.
until [ -s /etc/rancher/k3s/k3s.yaml ]; do sleep 2; done
until kubectl --kubeconfig /etc/rancher/k3s/k3s.yaml get --raw='/readyz' >/dev/null 2>&1; do
  sleep 2
done
