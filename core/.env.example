# Django settings
DJANGO_ENV=dev
SECRET_KEY=your-secret-key-here

# Field-level encryption key for OAuth tokens (REQUIRED for GDPR/CCPA compliance)
# Generate a new key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CRITICAL: Keep this key secret and DO NOT change it after deployment (you'll lose access to encrypted data)
FIELD_ENCRYPTION_KEY=your-encryption-key-here

# BYOK encryption — defaults to FIELD_ENCRYPTION_KEY if unset.
# In prod, set this to its own Fernet key for blast-radius isolation.
BYOK_ENCRYPTION_KEY=
# Comma-separated legacy keys for rotation (MultiFernet). Leave empty
# unless you are mid-rotation; see docs/operations/byok-key-rotation.md
BYOK_ENCRYPTION_KEY_LEGACY=

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database
DB_NAME=sterna_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Frontend URL for OAuth redirects
# Used by backend to redirect users after OAuth flows complete
FRONTEND_URL=http://localhost:5173

# Backend URL for MCP OAuth callbacks
# Used for OAuth callback endpoints (e.g., /api/mcp/oauth/callback/)
SITE_URL=http://localhost:8000

# Public site URL sent as the OpenRouter attribution header
# (HTTP-Referer / X-Title). Set to your real public URL in production.
OPENROUTER_SITE_URL=https://example.com

# Email (production - Resend transactional provider)
# Get an API key at https://resend.com/api-keys.
# DEFAULT_FROM_EMAIL must be on a Resend-verified domain
# (DKIM + SPF + DMARC configured for your own domain). See
# infra-migration/README.md for how production secrets are generated
# and populated.
RESEND_API_KEY=re_your_key_here
DEFAULT_FROM_EMAIL=noreply@example.com
SUPPORT_EMAIL=support@example.com
BRAND_NAME=Sterna

# ============================================================================
# Stripe billing (task 11)
# ============================================================================
# Get your test keys from https://dashboard.stripe.com/test/apikeys
# - STRIPE_API_KEY: server-side secret key (sk_test_… in dev/staging,
#                   sk_live_… in prod). NEVER commit. See infra-migration/README.md
#                   for how production secrets are generated and populated.
# - STRIPE_PUBLISHABLE_KEY: pk_test_… or pk_live_…, used by the frontend
#                           checkout component (task 12).
# - STRIPE_WEBHOOK_SECRET: whsec_…, used by the webhook handler (task 13).
#                          Not yet required — leave blank until task 13.
#
# In dev these can all be empty — the get_or_create_stripe_customer
# service detects an unset key and short-circuits without API calls.
STRIPE_API_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# S3 configuration (optional - only for external integrations)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=

# OpenRouter configuration
# System-level API key (fallback for unauthenticated requests)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-4-turbo-preview

# OpenRouter Provisioning API (for per-user API keys)
# Create a provisioning key at: https://openrouter.ai/settings/provisioning-keys
# This enables automatic API key creation for each user with usage tracking
OPENROUTER_PROVISIONING_KEY=your-provisioning-key-here
# Default credit limit for new users (USD) - set high as safety backstop
# Your own usage service will enforce the real limits across all providers
OPENROUTER_DEFAULT_USER_LIMIT=100.0
# Limit reset frequency: daily, weekly, monthly, or empty for no reset
OPENROUTER_LIMIT_RESET=weekly

# Sentry (optional)
SENTRY_DSN=

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Development tools
ENABLE_DEBUG_TOOLBAR=False
CELERY_TASK_ALWAYS_EAGER=False

# Google OAuth Configuration
# To obtain these credentials:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select existing
# 3. Enable Google+ API
# 4. Create OAuth 2.0 credentials (Web application)
# 5. Add authorized redirect URIs:
#    - http://localhost:5173 (development)
#    - http://localhost:8000/api/auth/google/callback (if using backend flow)
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id-here
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret-here

# GitHub OAuth Configuration (shared for authentication + MCP connector)
# To obtain these credentials:
# 1. Go to https://github.com/settings/developers
# 2. Create a new OAuth App or GitHub App
# 3. Set Authorization callback URL to:
#    - http://localhost:5173/oauth/callback (development - unified handler)
#    - https://your-domain.com/oauth/callback (production - unified handler)
# Note: Same app is used for both authentication and MCP connector
#       The flows are differentiated by the state parameter:
#       - Authentication: normal state
#       - MCP connector: state prefixed with "mcp:"
GITHUB_OAUTH_CLIENT_ID=your-github-client-id-here
GITHUB_OAUTH_CLIENT_SECRET=your-github-client-secret-here
GITHUB_OAUTH_REDIRECT_URI=http://localhost:5173/oauth/callback

# ============================================================================
# MCP Connector OAuth Configurations
# ============================================================================
# Each MCP connector requires its own OAuth app credentials.
# All connectors use the same redirect URI for the unified OAuth callback handler.
# Redirect URI: http://localhost:5173/oauth/callback (development)
#               https://your-domain.com/oauth/callback (production)

# Notion OAuth Configuration (MCP Connector)
# To obtain these credentials:
# 1. Go to https://www.notion.so/my-integrations
# 2. Create a new integration
# 3. Note the OAuth Client ID and Client Secret
# 4. Add redirect URI: http://localhost:5173/oauth/callback
NOTION_OAUTH_CLIENT_ID=your-notion-client-id-here
NOTION_OAUTH_CLIENT_SECRET=your-notion-client-secret-here
NOTION_OAUTH_REDIRECT_URI=http://localhost:5173/oauth/callback

# Slack OAuth Configuration (MCP Connector)
# To obtain these credentials:
# 1. Go to https://api.slack.com/apps
# 2. Create a new Slack App
# 3. Under "OAuth & Permissions", note your Client ID and Client Secret
# 4. Add redirect URI: http://localhost:5173/oauth/callback
# 5. Add OAuth scopes: channels:read, chat:write, users:read
SLACK_OAUTH_CLIENT_ID=your-slack-client-id-here
SLACK_OAUTH_CLIENT_SECRET=your-slack-client-secret-here
SLACK_OAUTH_REDIRECT_URI=http://localhost:5173/oauth/callback

# Atlassian OAuth Configuration (MCP Connector - Jira/Confluence)
# To obtain these credentials:
# 1. Go to https://developer.atlassian.com/console/myapps/
# 2. Create a new OAuth 2.0 integration
# 3. Note the Client ID and Client Secret
# 4. Add redirect URI: http://localhost:5173/oauth/callback
# 5. Add scopes: read:jira-work, write:jira-work, read:confluence-content.all
ATLASSIAN_OAUTH_CLIENT_ID=your-atlassian-client-id-here
ATLASSIAN_OAUTH_CLIENT_SECRET=your-atlassian-client-secret-here
ATLASSIAN_OAUTH_REDIRECT_URI=http://localhost:5173/oauth/callback

# ============================================================================
# Cloudflare Turnstile (CAPTCHA) — task 19
# ============================================================================
# Free, GDPR-compliant CAPTCHA used on signup forms.
# Get a site/secret pair at:
#   https://dash.cloudflare.com/?to=/:account/turnstile
# In development (DEBUG=True) the backend bypasses verification — leave
# these blank if you don't need to test the production behavior locally.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Disposable email allowlist (task 19)
# Comma-separated list of EMAIL ADDRESSES (not domains) to allow even
# if the domain is on the blocklist. Operations escape hatch for
# legitimate customer support cases.
DISPOSABLE_EMAIL_ALLOWLIST=

# BRAVE SEARCH
# Free API key
#BRAVE_API_KEY=free-brave-api-key

# Pro API key
BRAVE_API_KEY=pro-brave-api-key

# GOOGLE MAPS
# To obtain this key:
# 1. Go to https://console.cloud.google.com/
# 2. Enable Maps, Places, and Geocoding APIs
# 3. Create an API key
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ============================================================================
# Image Generation (Nano Banana Models)
# ============================================================================
# Image generation uses Gemini models with a fallback chain for reliability:
# 1. Google AI Studio (free tier - 5 RPM, 25 RPD)
# 2. OpenRouter (fallback, uses OPENROUTER_API_KEY)
#
# Available models:
# - nano-banana: Fast, good quality (gemini-2.0-flash-exp)
# - nano-banana-pro: Best quality (gemini-2.0-pro-exp-02-05)

# Google AI Studio API Key (FREE tier - recommended)
# Get your key at: https://aistudio.google.com/apikey
# 1. Sign up/login to Google AI Studio
# 2. Click "Get API Key" in the sidebar
# 3. Create a new API key
GOOGLE_AI_STUDIO_API_KEY=your-google-ai-studio-api-key

# Note: OpenRouter (OPENROUTER_API_KEY) is configured above and used as fallback

# ============================================================================
# Voice Room Provider API Keys
# ============================================================================
# Required for the multi-AI voice conversation feature.

# Deepgram (Speech-to-Text)
# Best for real-time STT with turn detection for voice agents
# Get your key at: https://console.deepgram.com/signup
# 1. Sign up for a free account ($200 free credit)
# 2. Go to API Keys section
# 3. Create a new API key
# Models used: Nova-2 (default), Flux (recommended for voice agents)
DEEPGRAM_API_KEY=your-deepgram-api-key

# ElevenLabs (Text-to-Speech)
# Best quality voices for AI agents
# Get your key at: https://elevenlabs.io/
# 1. Sign up for an account (free tier available)
# 2. Go to Profile Settings > API Key
# 3. Copy your API key
# Models used: eleven_flash_v2_5 (recommended for low latency)
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Note: Voice rooms also use OPENROUTER_API_KEY (configured above)
# for LLM completions. Make sure it's set.

# ============================================================================
# Sandbox/Orchestrator Service Configuration
# ============================================================================
# These variables configure the sandbox orchestration service for code execution.

# JWT Authentication for Orchestrator (REQUIRED in production)
# Generate a strong key with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# SECURITY: Must be at least 32 characters. Service will fail to start without it in production.
# docker-compose.yml also feeds this into the api-gateway container as
# GATEWAY_JWT_SECRET_KEY — the gateway validates the same tokens Django
# issues, so both services must share this value.
JWT_SECRET_KEY=your-jwt-secret-key-here-at-least-32-characters
JWT_ALGORITHM=HS256

# Internal Service Token (orchestrator -> Django backend authentication)
# REQUIRED in production for workspace sync security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# This token authenticates workspace save/restore calls from the orchestrator
# In development (DEBUG=True), requests are allowed without this token
INTERNAL_SERVICE_TOKEN=your-internal-service-token-here

# CORS Origins for Orchestrator
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Egress Proxy for sandbox network access
EGRESS_PROXY_URL=http://egress-proxy:8888

# Sandbox Docker Network
SANDBOX_NETWORK=sandbox-network

# ============================================================================
# API Gateway Configuration (core/api-gateway) — GATEWAY_ prefix
# ============================================================================
# Full settings model: core/api-gateway/gateway/config.py

# Fails startup by default if GATEWAY_JWT_SECRET_KEY is unset or a known
# placeholder (empty, "change-me-in-production", or the shared
# "django-insecure-…" dev marker above) — same fail-loud philosophy as
# core/sterna/settings/prod.py's SECRET_KEY guard. Only honored when
# GATEWAY_ENVIRONMENT=development, so a stray "true" left in a
# staging/production config can never reopen the guard. docker-compose.yml
# sets both for local dev already.
# GATEWAY_ALLOW_INSECURE_JWT_SECRET=false

# Origins allowed to make credentialed (cookie/Authorization) requests
# through the gateway. Must be a JSON array — pydantic-settings' env
# convention for list fields, matching GATEWAY_ROUTES/GATEWAY_PUBLIC_PATHS.
# No built-in default: every environment must set this explicitly, or the
# gateway refuses to start (see the CORS validator in config.py). Wildcard
# ("*") is likewise rejected whenever credentials are allowed (the default).
# GATEWAY_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# GATEWAY_CORS_ALLOW_CREDENTIALS=true

# Use gVisor for enhanced container isolation (optional, requires gVisor installed)
USE_GVISOR=false

# Skills host path (absolute path to skills directory on host machine)
# Used for mounting skills into sandbox containers
# SKILLS_HOST_PATH=/absolute/path/to/skills

# ============================================================================
# Internal Service URLs
# ============================================================================
# These are typically set automatically in Docker Compose but can be overridden

# Google Maps Service (for location-based features)
GOOGLE_MAPS_SERVICE_URL=http://google-maps:8005

# ============================================================================
# Load Testing Configuration (Development Only)
# ============================================================================
# Used by the load testing scripts in /load_testing

LOAD_TEST_BASE_URL=http://localhost:8000
LOAD_TEST_USERNAME=loadtest@example.com
LOAD_TEST_PASSWORD=TestPassword123!

# ============================================================================
# OpenAI API Key
# ============================================================================
# Used for video generation (Sora) and other OpenAI services
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# ============================================================================
# Runway API Key (Video Generation)
# ============================================================================
# Used for video generation with Runway models (Veo, Gen-4, Act Two, Upscale)
# Get your key at: https://dev.runwayml.com/
# 1. Sign up for a Runway account
# 2. Go to API settings
# 3. Create a new API key
RUNWAY_API_KEY=your-runway-api-key

# ============================================================================
# Cloudflare R2 Storage (for workspace file persistence)
# ============================================================================
# R2 is S3-compatible storage for large workspace files (>=256KB)
# Small files (<256KB) are stored inline in PostgreSQL
# Get R2 credentials at: https://dash.cloudflare.com/ > R2 > Manage R2 API Tokens

R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=sterna-workspaces
# For production R2, leave empty to use default Cloudflare endpoint
# For local dev with MinIO, set to: http://minio:9000
R2_ENDPOINT_URL=

# Smoke-suite env (task 28)
# See docs/migration/cold-bring-up-runbook.md and core/smoke/README.md.
# In a deployed environment these come from the smoke-secrets
# ExternalSecret (k8s Secret → pod env). Set locally only if you want
# to run `pytest -c /dev/null smoke/ -v` against a dev server.
# SMOKE_BASE_URL=
# SMOKE_TEST_USER_EMAIL=smoke@sterna-internal.test
# SMOKE_TEST_USER_PASSWORD=
# SMOKE_STRIPE_WEBHOOK_SECRET=

# ============================================================================
# Connection URLs (override the discrete DB_*/REDIS_* vars above)
# ============================================================================
# Single-URL forms used in staging/production (Neon + k8s). When set,
# they take precedence over DB_HOST/DB_NAME/... and REDIS_HOST/... above.
# Full PostgreSQL DSN, e.g. postgresql://user:pass@host:5432/dbname
# DATABASE_URL=
# Full Redis URL, e.g. redis://localhost:6379/0
# REDIS_URL=

# ============================================================================
# GitHub App (code-sessions / coding-agent repo integration)
# ============================================================================
# Create a GitHub App at https://github.com/settings/apps — used for
# repo cloning, issues/PRs in the Project side panel. Distinct from the
# GITHUB_OAUTH_* login app above.
# Numeric App ID from the app settings page
# GITHUB_APP_ID=
# PEM private key contents (or a path, depending on deployment)
# GITHUB_PRIVATE_KEY=
# Webhook secret configured on the GitHub App
# GITHUB_WEBHOOK_SECRET=

# ============================================================================
# Deployment / environment flags
# ============================================================================
# Environment name used for per-env resource names (development/staging/production)
# ENVIRONMENT=development
# Serve static assets from a CDN in prod (default /static/)
# STATIC_URL=/static/
# Force HTTPS redirects in prod (default False — TLS terminates at Cloudflare)
# SECURE_SSL_REDIRECT=False
# Require the CF-Connecting-IP header for rate-limit keying (prod default True)
# CF_REQUIRE_HEADER=False
# Accept dev-* JWTs without verification (dev default True; prod hard-blocks)
# DEV_TOKEN_BYPASS=True
# Slack webhook for support-request notifications (empty = disabled)
# SUPPORT_SLACK_WEBHOOK_URL=

# ============================================================================
# Observability (OpenTelemetry + Prometheus)
# ============================================================================
# Service name reported to the OTLP collector
# OTEL_SERVICE_NAME=sterna-ai
# Service version reported to the OTLP collector
# OTEL_SERVICE_VERSION=1.0.0
# OTLP exporter endpoint (empty = tracing disabled)
# OTEL_EXPORTER_OTLP_ENDPOINT=
# Port for the Prometheus metrics exporter
# PROMETHEUS_METRICS_PORT=9090

# ============================================================================
# Voice room tuning (defaults shown; rarely need overriding)
# ============================================================================
# Deepgram STT model
# DEEPGRAM_MODEL=nova-2
# Add punctuation to transcripts
# DEEPGRAM_PUNCTUATE=True
# Stream interim (partial) transcription results
# DEEPGRAM_INTERIM_RESULTS=True
# Silence (ms) before Deepgram closes a speech segment
# DEEPGRAM_ENDPOINTING_MS=500
# Silence (ms) before an utterance is considered finished
# DEEPGRAM_UTTERANCE_END_MS=1500
# ElevenLabs TTS model
# ELEVENLABS_MODEL=eleven_flash_v2_5
# Latency optimization 0 (best quality) .. 4 (lowest latency)
# ELEVENLABS_OPTIMIZE_LATENCY=2
# Voice stability 0..1
# ELEVENLABS_STABILITY=0.5
# Voice similarity boost 0..1
# ELEVENLABS_SIMILARITY_BOOST=0.8
# Voice expressiveness 0..1
# ELEVENLABS_STYLE=0.3
# Enable speaker boost
# ELEVENLABS_USE_SPEAKER_BOOST=True
# Audio sample rate (Hz)
# AUDIO_SAMPLE_RATE=16000
# Audio channel count
# AUDIO_CHANNELS=1
# Default max tokens per voice-agent LLM completion
# DEFAULT_MAX_TOKENS=500
# Max AI agents per voice room
# MAX_AGENTS_PER_ROOM=5

# ============================================================================
# Knowledge base (RAG) tuning (defaults shown)
# ============================================================================
# Embedding model (via OpenRouter)
# KNOWLEDGE_BASE_EMBEDDING_MODEL=openai/text-embedding-3-large
# Embedding vector dimensions
# KNOWLEDGE_BASE_EMBEDDING_DIMENSIONS=1536
# Embeddings API endpoint
# KNOWLEDGE_BASE_EMBEDDING_API_URL=https://openrouter.ai/api/v1/embeddings
# Chunk size (tokens) for document splitting
# KNOWLEDGE_BASE_CHUNK_SIZE=500
# Overlap (tokens) between adjacent chunks
# KNOWLEDGE_BASE_CHUNK_OVERLAP=50
# Files below this size (bytes) are stored inline in PostgreSQL
# KNOWLEDGE_BASE_INLINE_THRESHOLD=262144
# R2 bucket for knowledge-base file storage
# KNOWLEDGE_BASE_R2_BUCKET=sternaway-knowledge
# Default per-user knowledge-base storage quota (MB)
# KNOWLEDGE_BASE_DEFAULT_STORAGE_MB=100
# Default similarity threshold for retrieval (0..1)
# KNOWLEDGE_BASE_DEFAULT_SIMILARITY_THRESHOLD=0.7
# Default max chunks returned per retrieval
# KNOWLEDGE_BASE_DEFAULT_MAX_CHUNKS=5
# Max tokens of retrieved context injected into a prompt
# KNOWLEDGE_BASE_MAX_CONTEXT_TOKENS=2000

# ============================================================================
# Workspace file persistence limits (defaults shown)
# ============================================================================
# Files below this size (bytes) are stored inline in PostgreSQL; larger go to R2
# WORKSPACE_INLINE_THRESHOLD=262144
# Max size (bytes) of a single workspace file (50MB)
# WORKSPACE_MAX_FILE_SIZE=52428800
# Max total size (bytes) of a workspace (500MB)
# WORKSPACE_MAX_SIZE=524288000

# ============================================================================
# Orchestrator URL (Django backend -> orchestrator service)
# ============================================================================
# Overridden per environment in k8s (web-config); compose default shown
# ORCHESTRATOR_URL=http://orchestrator:8003
# ============================================================================
# Optional runtime flags (safe defaults; rarely need changing)
# ============================================================================
# Set true ONLY for celery worker/beat processes booted with prod settings:
# skips the mandatory ALLOWED_HOSTS check (workers never serve HTTP).
# WORKER_MODE=false
# Refresh-token rotation reuse-grace window in seconds (concurrent-refresh
# tolerance; see authentication/jwt_utils.py).
# JWT_REFRESH_ROTATION_GRACE_SECONDS=60
