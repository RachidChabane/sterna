# =============================================================================
# .env.production template — single-VPS compose deployment
# =============================================================================
# Copy to .env.production, uncomment and fill every var you need, then:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d
#
# This file is consumed TWICE:
#   1. by `--env-file` for ${VAR} interpolation inside
#      docker-compose.prod.yml (image tags, postgres password, tunnel
#      token, per-service keys), and
#   2. via `env_file:` injected wholesale into web / celery-worker /
#      celery-beat (Django settings read these directly).
#
# NEVER commit the filled file. Values live in Scaleway Secret Manager —
# see infra-migration/README.md (Secrets flow) for how each secret is
# generated and populated into Scaleway Secret Manager.
# Vars marked [REQUIRED] hard-fail the web container at boot
# (sterna/settings/prod.py uses fail-loud env() reads for them).

# ============================================================================
# Compose-level settings (interpolation only — not read by Django)
# ============================================================================
# Cloudflare tunnel token from the Zero Trust dashboard (runbook step 6).
# [REQUIRED — compose refuses to start cloudflared without it]
# CLOUDFLARE_TUNNEL_TOKEN=

# Local postgres credentials (ignored if you point DATABASE_URL at Neon).
# [REQUIRED — compose refuses to start postgres without the password]
# POSTGRES_PASSWORD=
# POSTGRES_USER=postgres
# POSTGRES_DB=sterna

# Image coordinates when pulling from GHCR instead of building locally.
# GHCR_OWNER must be the LOWERCASED GitHub org/user. Tags: master-latest,
# develop-latest, a semver (e.g. 2.3.1) or a commit SHA — see ci.yml.
# GHCR_OWNER=
# IMAGE_TAG=master-latest

# ============================================================================
# Django core  (Secret Manager group: api-secrets)
# ============================================================================
# Django SECRET_KEY. Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
# SECRET_KEY=
# JWT signing key (web + api-gateway + user-preferences must agree).
# Generate like SECRET_KEY. Min 32 chars.
# JWT_SECRET_KEY=
# Fernet key for field-level encryption (OAuth tokens). DO NOT rotate
# carelessly — see docs/operations/byok-key-rotation.md.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FIELD_ENCRYPTION_KEY=
# Separate Fernet key for BYOK blast-radius isolation (optional;
# defaults to FIELD_ENCRYPTION_KEY)
# BYOK_ENCRYPTION_KEY=
# BYOK_ENCRYPTION_KEY_LEGACY=

# Comma-separated hostnames Django will serve
# ALLOWED_HOSTS=app.example.com,api.example.com,web
# Public URLs (OAuth redirects, links in emails)
# FRONTEND_URL=https://app.example.com
# SITE_URL=https://api.example.com
# CORS_ALLOWED_ORIGINS=https://app.example.com

# ============================================================================
# Database (Secret Manager group: database-secrets)
# ============================================================================
# Leave unset to use the compose-local postgres service. Set to a Neon
# DSN to use managed PostgreSQL instead (then the postgres service and
# the pg_dump backup cron become unnecessary — Neon has PITR).
# DATABASE_URL=

# ============================================================================
# Transactional email  (Resend)
# ============================================================================
# [REQUIRED] Resend API key (re_…)
# RESEND_API_KEY=
# [REQUIRED] Must be on a Resend-verified domain
# DEFAULT_FROM_EMAIL=noreply@example.com
# SUPPORT_EMAIL=support@example.com
# BRAND_NAME=Sterna

# ============================================================================
# CAPTCHA  (Cloudflare Turnstile)
# ============================================================================
# [REQUIRED] both keys — prod settings fail loud without them
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ============================================================================
# Stripe billing
# ============================================================================
# [REQUIRED] all three — use sk_live_/pk_live_ in production;
# STRIPE_WEBHOOK_SECRET may be an empty string but must be present
# STRIPE_API_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# ============================================================================
# LLM providers  (Secret Manager group: llm-secrets)
# ============================================================================
# OPENROUTER_API_KEY=
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# OPENROUTER_PROVISIONING_KEY=
# OPENROUTER_DEFAULT_USER_LIMIT=100.0
# OPENROUTER_LIMIT_RESET=weekly
# OPENAI_API_KEY=
# GOOGLE_AI_STUDIO_API_KEY=
# RUNWAY_API_KEY=
# ANTHROPIC_API_KEY=

# ============================================================================
# Voice providers  (Secret Manager group: voice-secrets)
# ============================================================================
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=

# ============================================================================
# External services  (Secret Manager group: external-services-secrets)
# ============================================================================
# BRAVE_API_KEY=
# GOOGLE_MAPS_API_KEY=

# ============================================================================
# OAuth  (Secret Manager group: oauth-secrets)
# ============================================================================
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URI=https://app.example.com/oauth/callback
# NOTION_OAUTH_CLIENT_ID=
# NOTION_OAUTH_CLIENT_SECRET=
# NOTION_OAUTH_REDIRECT_URI=https://app.example.com/oauth/callback
# SLACK_OAUTH_CLIENT_ID=
# SLACK_OAUTH_CLIENT_SECRET=
# SLACK_OAUTH_REDIRECT_URI=https://app.example.com/oauth/callback
# ATLASSIAN_OAUTH_CLIENT_ID=
# ATLASSIAN_OAUTH_CLIENT_SECRET=
# ATLASSIAN_OAUTH_REDIRECT_URI=https://app.example.com/oauth/callback

# GitHub App (coding-agent repo integration — distinct from OAuth login)
# GITHUB_APP_ID=
# GITHUB_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=

# ============================================================================
# Storage — Cloudflare R2  (Secret Manager group: storage-secrets)
# ============================================================================
# Used for workspace files, knowledge base and DB backups (runbook §9)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=sterna-workspaces
# R2_ENDPOINT_URL=

# ============================================================================
# Observability  (Sentry, optional)
# ============================================================================
# Per-service DSNs; each maps to SENTRY_DSN inside its container
# (same convention as the k8s deployments). Leave unset to disable.
# SENTRY_DSN=
# SENTRY_DSN_API_GATEWAY=
# SENTRY_DSN_USER_PREFS=
# SENTRY_DSN_BRAVE=
# SENTRY_DSN_MAPS=
# SENTRY_DSN_ORCHESTRATOR=

# ============================================================================
# Sandbox profile only  (docker compose --profile sandbox)
# ============================================================================
# Token authenticating orchestrator -> Django workspace sync.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# INTERNAL_SERVICE_TOKEN=

# ============================================================================
# Smoke suite  (optional)
# ============================================================================
# SMOKE_TEST_USER_PASSWORD=
# SMOKE_STRIPE_WEBHOOK_SECRET=
