      "user_id": "<uuid-1>",
      "conversation_id": "<uuid-2>",
      "chat_id": "<uuid-3>",
      "sync_mode": true
    }
  },
  {
    "url": "http://orchestrator:8003/fs/bash",
    "payload": {
      "user_id": "<uuid-1>",
      "conversation_id": "<uuid-2>",
      "chat_id": "<uuid-3>",
