      "openrouter_api_key": "sk-golden-fixture",
      "model_metadata": {
        "model_name": "Golden Fixture Model",
        "model_id": "fixture/golden-model",
        "provider": "fixture",
        "model_icon_slug": null,
        "model_icon_url": null,
        "provider_icon_slug": null,
        "provider_icon_url": null,
        "message_id": null
      },
      "mcp_servers": {},
      "mode": "implement",
      "plan_id": "<uuid-4>",
      "sub_agents": [],
      "user_model_preferences": {
        "fast_model_id": "anthropic/claude-haiku-4.5",
        "balanced_model_id": "anthropic/claude-sonnet-4.5",
        "powerful_model_id": "anthropic/claude-opus-4"
      },
      "budget_usd": 20.0
    }
  },
  {
    "url": "http://orchestrator:8003/coding-agent/progress",
