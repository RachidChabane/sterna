data: {"generation_id": "genid-golden-first"}

event: content
data: {"content": "Reading and searching."}

event: file_tool_executing
data: {"tool_calls": [{"function": {"name": "...", "arguments": "{}"}, "id": "loading", "type": "function"}]}

event: usage_update
data: {"usage": {"prompt_tokens": 120, "completion_tokens": 40, "total_tokens": 160}, "cost": 0.00019999999999999998, "prompt_cost": 0.00011999999999999999, "completion_cost": 7.999999999999999e-05, "generation_id": "genid-golden-first", "generation_ids": ["genid-golden-first"]}

event: file_tool_executing
data: {"tool_calls": [{"id": "toolcall-read-file", "type": "function", "function": {"name": "read_file", "arguments": "{\"path\": \"/workspace/notes.md\"}"}, "display_name": "Read File"}, {"id": "toolcall-web-search", "type": "function", "function": {"name": "brave_web_search", "arguments": "{\"query\": \"sterna streaming\"}"}, "display_name": "Web Search"}]}

event: heartbeat
data: {"tool": "read_file", "elapsed_seconds": <elapsed-seconds>}

event: heartbeat
data: {"tool": "brave_web_search", "elapsed_seconds": <elapsed-seconds>}

event: file_tool_executed
data: {"tool_calls": [{"id": "toolcall-read-file", "type": "function", "function": {"name": "read_file", "arguments": "{\"path\": \"/workspace/notes.md\"}"}, "display_name": "Read File"}, {"id": "toolcall-web-search", "type": "function", "function": {"name": "brave_web_search", "arguments": "{\"query\": \"sterna streaming\"}"}, "display_name": "Web Search"}], "results": [{"tool_call": {"id": "toolcall-read-file", "type": "function", "function": {"name": "read_file", "arguments": "{\"path\": \"/workspace/notes.md\"}"}}, "result": {"success": true, "content": "# Notes\nfirst line\n"}, "success": true}, {"tool_call": {"id": "toolcall-web-search", "type": "function", "function": {"name": "brave_web_search", "arguments": "{\"query\": \"sterna streaming\"}"}}, "result": {"success": true, "results": [{"url": "https://example.invalid/sterna", "title": "Sterna streaming"}]}, "success": true}]}

event: web_sources
data: {"sources": [{"url": "https://example.invalid/sterna", "title": "Sterna streaming"}]}

