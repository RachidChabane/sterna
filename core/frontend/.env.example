# ============================================================================
# Frontend Environment Variables
# ============================================================================
# All frontend environment variables must be prefixed with VITE_ to be
# accessible in the browser bundle (Vite convention).

# ============================================================================
# Site identity
# ============================================================================

# Public domain used to derive the support email and status page links
# (support@<domain>, status.<domain>). Defaults to example.com.
VITE_SITE_DOMAIN=example.com

# ============================================================================
# Development Settings
# ============================================================================

# Enable development authentication bypass
# Set to 'true' to allow dev tokens without real JWT validation
# WARNING: Never enable in production!
VITE_ENABLE_DEV_AUTH=true

# Debug mode - enables additional console logging
VITE_DEBUG=true

# ============================================================================
# API URLs
# ============================================================================

# ============================================================================
# API Gateway Configuration
# ============================================================================
# All API requests route through the API Gateway (port 8080) which handles:
# - JWT authentication and validation
# - Rate limiting (Redis-backed sliding window)
# - Request routing to backend services
# - Header enrichment (X-User-ID, X-Request-ID)

# API URL - routes through API Gateway
VITE_API_URL=http://localhost:8080

# Backend URL for client-side redirects
# In dev: routes through gateway
# In prod: leave empty to use same origin (proxied via Cloudflare Tunnel)
VITE_BACKEND_URL=http://localhost:8080

# Orchestrator URL for code execution (sandbox service)
# Routes through API Gateway at /api/v1/sandbox
VITE_ORCHESTRATOR_URL=http://localhost:8080/api/v1/sandbox

# ============================================================================
# Direct Access (Debugging Only)
# ============================================================================
# Uncomment to bypass gateway for debugging:
# VITE_API_URL=http://localhost:8000
# VITE_ORCHESTRATOR_URL=http://localhost:8003

# ============================================================================
# OAuth Configuration
# ============================================================================
# These should match the client IDs configured in your backend .env file

# Google OAuth Configuration
# To obtain: Follow the instructions in ../.env.example
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# GitHub OAuth Configuration
# To obtain: Follow the instructions in ../.env.example
VITE_GITHUB_CLIENT_ID=your_github_client_id_here

# ============================================================================
# Google Maps
# ============================================================================

# Google Maps API Key
# Dev: No restrictions needed
# Prod: Enable "Sites Web" restriction (add your domain) + restrict to Maps/Places APIs
# https://console.cloud.google.com/apis/credentials
# Enable the API: https://console.cloud.google.com/apis/library/maps-backend.googleapis.com
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ============================================================================
# Cloudflare Turnstile (CAPTCHA) — task 19
# ============================================================================
# Public site key, paired with TURNSTILE_SECRET_KEY in core/.env.
# Leave blank in dev to skip the widget — the backend bypasses
# verification when DEBUG=True.
VITE_TURNSTILE_SITE_KEY=
