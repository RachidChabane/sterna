#!/usr/bin/env bash
# tsc is the enforced type gate for the frontend. mypy is an enforced
# gate over the Django app tree (the standalone microservices under
# core/ — api-gateway, brave-search, google-maps,
# user-preferences-service, sandbox — carry their own dependency stacks
# and are excluded to avoid cross-service module clashes): any type
# error fails this script. Its error count is also printed in a stable
# `RATCHET` line so script/ratchet can independently track the count
# and the checked-file denominator over time. mypy exit >= 2 (crash,
# bad config, module clash) is a harness fault and fails this script
# the same way — a tool that didn't run must never be reported as a
# clean pass.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

echo "==> mypy (gates)"
set +e
mypy_output="$(
  cd "$repo_root/core" && "$repo_root/.venv/bin/mypy" \
    --exclude '^(api-gateway|brave-search|google-maps|user-preferences-service|sandbox)/' \
    . 2>&1
)"
mypy_exit=$?
set -e

if [ "$mypy_exit" -ge 2 ]; then
  echo "mypy failed to complete a full pass (exit ${mypy_exit}); treating as a harness fault, not a type-error count." >&2
  printf '%s\n' "$mypy_output" >&2
  exit 1
fi

if printf '%s\n' "$mypy_output" | grep -q '^Success: no issues found'; then
  mypy_errors=0
elif [[ "$mypy_output" =~ Found\ ([0-9]+)\ error[s]?\ in\ [0-9]+\ file ]]; then
  mypy_errors="${BASH_REMATCH[1]}"
else
  echo "mypy exited ${mypy_exit} without its usual summary line; treating as a harness fault." >&2
  printf '%s\n' "$mypy_output" >&2
  exit 1
fi

echo "RATCHET mypy_errors=${mypy_errors}"

if [ "$mypy_errors" -gt 0 ]; then
  printf '%s\n' "$mypy_output" >&2
  echo "mypy found ${mypy_errors} error(s); this is a hard gate." >&2
  exit 1
fi

echo "==> tsc --noEmit (frontend, gates)"
(cd "$repo_root/core/frontend" && pnpm exec tsc -b --noEmit)

echo "==> Typecheck complete"
