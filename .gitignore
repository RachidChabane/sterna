# IMPORTANT: Ignore everything at root except core directory and essential files
/*
!/.gitignore
!/.git
!/.github/
!/core/
!/infra-migration/
!/docs/
!/script/
!/README.md
!/CONTRIBUTING.md
!/LICENSE
!/NOTICE
!/SECURITY.md
!/CODE_OF_CONDUCT.md

# Dependencies
node_modules/
*.pyc
__pycache__/
.Python
env/
venv/
ENV/
.venv/
pip-log.txt
pip-delete-this-directory.txt

# Build outputs
dist/
build/
*.egg-info/
.eggs/
*.egg
*.whl
target/
out/
bin/

# Testing
.coverage
.pytest_cache/
.tox/
htmlcov/
.hypothesis/
coverage.xml
*.cover
.cache
nosetests.xml
test-results/
junit.xml

# IDE and Editor files
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.npm

# Environment files
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
*.env

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Package manager debug logs (but NOT lock files - those should be committed)
.pnpm-debug.log*

# Temporary files
tmp/
temp/
.tmp/
*.tmp
*.temp
*.bak
*.backup
*.old

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

